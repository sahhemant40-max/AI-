# AI SENTINEL — Backend Environment Variables Configuration
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
DEBUG=True

# MongoDB Connection
# For local MongoDB Community Server:
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=ai_sentinel

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=dev-secret-key-ai-sentinel-governance-platform-2026

# Storage Paths
UPLOAD_DIR=storage/uploads
REPORTS_DIR=storage/reports
MAX_UPLOAD_SIZE_MB=50
